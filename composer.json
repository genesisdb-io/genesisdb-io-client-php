{
  "name": "genesisdb/client-sdk",
  "description": "The official PHP client for GenesisDB, the open source event sourcing database",
  "type": "library",
  "license": "MIT",
  "keywords": ["genesisdb", "event-sourcing", "event-store", "cloudevents", "cqrs", "database", "client"],
  "homepage": "https://www.genesisdb.io",
  "authors": [
    { "name": "Patric Eckhart", "email": "mail@genesisdb.io" }
  ],
  "support": {
    "docs": "https://docs.genesisdb.io",
    "source": "https://github.com/genesisdb-io/genesisdb-io-client-php"
  },
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "GenesisDB\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "GenesisDB\\Tests\\": "tests/" }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
